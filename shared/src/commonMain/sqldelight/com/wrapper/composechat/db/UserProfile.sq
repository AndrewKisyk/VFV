CREATE TABLE user_profile (
  id INTEGER NOT NULL PRIMARY KEY,
  age TEXT NOT NULL,
  sex TEXT NOT NULL
);

selectProfile:
SELECT * FROM user_profile WHERE id = 1;

upsertProfile:
INSERT OR REPLACE INTO user_profile(id, age, sex)
VALUES (1, ?, ?);

clearProfile:
UPDATE user_profile SET age = '', sex = '' WHERE id = 1;
